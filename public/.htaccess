# =====================================================================
#  Prime Script — Racine web (document root = le dossier public/)
#  Compatible hébergement mutualisé Apache 2.4 + PHP 8
# =====================================================================

# ------------------------------------------------------------------ Réécriture d'URL
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si l'application est dans un sous-dossier, adaptez RewriteBase :
    # RewriteBase /prime-script/

    # Ne réécrit pas les fichiers réellement présents (CSS, JS, images, polices).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste passe par le front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# ------------------------------------------------------------------ Sécurité
# Interdit l'accès aux fichiers sensibles et aux sources versionnées.
<FilesMatch "\.(sql|md|log|ini|sh|bak|old|json|lock|yml|yaml|env|dist|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Pas de listing de répertoire
Options -Indexes

# En-têtes de sécurité (complétés par l'application)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Retire la signature PHP (information inutile aux attaquants)
    Header always unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------ Cache
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# ------------------------------------------------------------------ PHP (si autorisé)
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 2M
    php_value post_max_size 4M
</IfModule>

# Page d'erreur par défaut (l'application gère aussi ses propres 404)
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php
